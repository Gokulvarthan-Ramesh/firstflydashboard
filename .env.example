# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=firstfly_dashboard
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=firstfly-super-secret-key-change-in-production
JWT_EXPIRES_IN=8h

# ── CORS ────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email / SMTP ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@firstfly.in
SMTP_PASS=your_app_password_here
SMTP_FROM="First Fly Digital Solutions <info@firstfly.in>"
